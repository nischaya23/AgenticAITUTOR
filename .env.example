# Copy to .env. Keys stay on the backend; never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=sqlite:///./tutor.db
API_TIMEOUT=30
MAX_OUTPUT_TOKENS=1600
MAX_INPUT_CHARS=60000
FAILURE_THRESHOLD=1
STALL_SECONDS=30
COOLDOWN_SECONDS=45
AGGREGATION_SECONDS=5
TYPING_GRACE_SECONDS=3
BANDIT_WARMUP=12
IDLE_SECONDS=60
PROVIDER_CONCURRENCY=3
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Web search: free (Wikipedia + DuckDuckGo, no key), gemini (Google Search grounding), or off.
WEB_SEARCH_PROVIDER=free
WEB_SEARCH_MAX_PAGES=4
WEB_SEARCH_TIMEOUT=15
