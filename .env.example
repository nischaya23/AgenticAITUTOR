# Copy to .env. Keys stay on the backend; never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=sqlite:///./tutor.db
API_TIMEOUT=30
MAX_OUTPUT_TOKENS=1600
MAX_INPUT_CHARS=60000
PROVIDER_CONCURRENCY=3
# Retry rounds for overloaded providers (HTTP 429/5xx) with exponential backoff (seconds).
LLM_MAX_ATTEMPTS=4
LLM_BACKOFF_SECONDS=2
LLM_MAX_BACKOFF_SECONDS=30
# Optional backup model used for later attempts when the main model stays overloaded.
GEMINI_FALLBACK_MODEL=
OPENAI_FALLBACK_MODEL=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Web search: free (Wikipedia + DuckDuckGo, no key), gemini (Google Search grounding), or off.
WEB_SEARCH_PROVIDER=free
WEB_SEARCH_ON_UPLOAD=true
WEB_SEARCH_MAX_PAGES=4
WEB_SEARCH_TIMEOUT=15
# Observer Agent triggers and routine review cadence.
OBSERVER_LLM_ENABLED=true
OBSERVER_PAUSE_SECONDS=8
IDLE_SECONDS=60
OBSERVER_REVIEW_SECONDS=30
