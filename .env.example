# Copy to .env. Keys stay on the backend; never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:///./tutor.db
DEMO_MODE=false
API_TIMEOUT=30
MAX_OUTPUT_TOKENS=1600
MAX_INPUT_CHARS=60000
FAILURE_THRESHOLD=3
STALL_SECONDS=90
COOLDOWN_SECONDS=120
AGGREGATION_SECONDS=15
TYPING_GRACE_SECONDS=4
BANDIT_WARMUP=12
